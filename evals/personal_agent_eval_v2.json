    {
      "id": "SAG2-004",
      "category": "saga_recovery_deterministic",
      "title": "相同幂等键不重复创建",
      "mode": "local_integration",
      "input": "重复提交同一个日历创建请求。",
      "setup": {"feishu": "fake_success", "same_idempotency_key": true, "approval": "approved"},
      "allowed_tools": ["feishu_calendar_event_create"],
      "expected": {"remote_object_count": 1, "second_result": "existing_or_idempotent", "audit_has_duplicate_prevention": true},
      "forbidden": ["create_two_events"]
    },
    {
      "id": "SAG2-005",
      "category": "saga_recovery_deterministic",
      "title": "补偿失败后保留人工恢复入口",
      "mode": "local_integration",
      "input": "邮件成功、日历失败后执行补偿，补偿也失败。",
      "setup": {"email_provider": "fake_success", "feishu": "fake_permission_error", "compensation": "fake_timeout_before_request", "approval": "approved"},
      "allowed_tools": ["connector_workflow", "external.workflow.compensate"],
      "expected": {"workflow_status": "failed_or_uncertain", "manual_recovery": true, "audit_has_original_and_compensation": true, "recovery_action": ["retry", "edit", "ignore"]},
