KORENEXT_PROVIDER=openai
KORENEXT_MODEL=gpt-4.1-mini
KORENEXT_API_KEY=
KORENEXT_BASE_URL=https://api.openai.com/v1
# Optional: context window override in tokens for an alias such as deepseek-v4-pro
KORENEXT_CONTEXT_WINDOW=
KORENEXT_HOST=127.0.0.1
KORENEXT_PORT=8765
KORENEXT_DATA_DIR=
KORENEXT_WORKSPACE_DIR=
KORENEXT_USER_SKILLS_DIR=
KORENEXT_MAX_STEPS=20
KORENEXT_SEARCH_PROVIDER=auto
KORENEXT_TAVILY_API_KEY=
KORENEXT_HTTP_ALLOW_PRIVATE_NETWORK=false
KORENEXT_WEB_ALLOWED_DOMAINS=
KORENEXT_WEB_BLOCKED_DOMAINS=
KORENEXT_WEB_REQUIRE_APPROVAL=false

# Real Chinese personal connectors
KORENEXT_FEISHU_APP_ID=
KORENEXT_FEISHU_APP_SECRET=
KORENEXT_FEISHU_REDIRECT_URI=http://127.0.0.1:8765/oauth/feishu/callback
# Optional token used to validate Feishu event callbacks.
KORENEXT_FEISHU_VERIFICATION_TOKEN=
# Optional Feishu/Lark event signature key. When set, callbacks must include
# X-Lark-Request-Timestamp, X-Lark-Request-Nonce and X-Lark-Signature.
KORENEXT_FEISHU_ENCRYPT_KEY=
# Optional: override the default Feishu OAuth scopes. Leave blank to use the
# built-in bundle below. Cloud document deletion also needs the drive write scope.
# After changing scopes, publish a new Feishu app version and authorize again.
# calendar:calendar task:task:write task:comment:write drive:drive
# docx:document contact:user.base:readonly
KORENEXT_FEISHU_SCOPES=
