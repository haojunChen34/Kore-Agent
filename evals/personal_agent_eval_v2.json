    {
      "id": "SAG2-003",
      "category": "saga_recovery_deterministic",
      "title": "结果未知时暂停而不是盲目重试",
      "mode": "local_integration",
      "input": "发送一封测试邮件。",
      "setup": {"email_provider": "fake_timeout_after_accept", "approval": "approved"},
      "allowed_tools": ["email_send", "external.operation.verify"],
      "expected": {"operation_status": "unknown", "remote_verification_offered": true, "automatic_retry": false, "user_message_mentions_unknown": true},
